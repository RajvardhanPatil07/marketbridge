# MarketBridge v1 runs in a safe synthetic demo mode without secrets.
PORT=8000
TZ=Asia/Kolkata

# Optional FX context for judge-facing INR display. Keep this explicit rather
# than hard-coding a stale exchange rate. Example: USDINR=83.50
# USDINR=

# Frontend API URL for separate local dev servers only.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Comma-separated browser origins allowed by CORS and the WebSocket endpoint.
# MARKETBRIDGE_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# -----------------------------------------------------------------------------
# FREE-FIRST LIVE CORE
# -----------------------------------------------------------------------------

# Alpaca Basic: use IEX for the zero-cost hackathon/live-display path.
# IEX is one venue/witness and MUST NOT be presented as full-market consensus.
# Keep credentials backend-only.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
ALPACA_FEED=iex
# ALPACA_REJECT_CONDITIONS=I
# ALPACA_MAX_NBBO_DEVIATION_BPS=150
# ALPACA_LIVE_SYMBOL_LIMIT=30

# Optional mapping from MarketBridge equity symbols to the exact Hyperliquid/HIP-3
# venue coins being observed. Hyperliquid is VENUE CONTEXT; its mark/oracle never
# feeds back into the independent underlying-equity reference.
# HYPERLIQUID_COIN_MAP={"NVDA":"xyz:NVDA","TSLA":"xyz:TSLA"}

# -----------------------------------------------------------------------------
# FREE CONTEXT / INTELLIGENCE PLANE
# -----------------------------------------------------------------------------

# Marketaux ticker-linked financial news. The backend caches responses for 20
# minutes to preserve free-tier allowance. News NEVER creates Market Truth.
# MARKETAUX_API_TOKEN=

# SEC EDGAR is public and requires no API key. Set a descriptive User-Agent with
# a contact address before public deployment to follow SEC fair-access guidance.
# MARKETBRIDGE_SEC_USER_AGENT="MarketBridge/1.0 team@example.com"

# Nasdaq Symbol Directory is fetched/cached by the existing symbol catalogue.
# MARKETBRIDGE_SYMBOL_DB=/absolute/path/to/nasdaq-symbols.sqlite3

# Optional macro context. Never risk/reference eligible.
# FRED_API_KEY=

# Optional crypto overview for discovery pages only. Never equity-risk eligible.
# COINGECKO_API_KEY=

# Twelve Data is OPTIONAL in v1. A free API key does not imply unrestricted
# WebSocket/display rights. It is not required for the free-first demo and should
# remain an internal cross-check unless the account entitlement explicitly allows
# the intended use.
# TWELVE_DATA_API_KEY=
# TWELVE_DATA_LIVE_SYMBOL_LIMIT=8
# Set ONLY after verifying your account's non-display/risk-computation rights.
# Without this explicit opt-in, Twelve Data remains visible context/cross-check data.
# TWELVE_DATA_RISK_ELIGIBLE=1

# Legacy Yahoo/yfinance fallback is research-only and disabled by default in v1.
# It can never qualify Market Truth.
MARKETBRIDGE_DISABLE_RESEARCH_FEED=1

# -----------------------------------------------------------------------------
# RISK / DEMO / SECURITY
# -----------------------------------------------------------------------------

# Fail readiness when a qualifying live feed is not configured/ready. Leave off
# for the public synthetic War Room; enable only for an entitled live deployment.
# MARKETBRIDGE_REQUIRE_LIVE_DATA=1

# Preferred Mochatrade integration authentication.
# Requests are signed as HMAC-SHA256(timestamp + "." + nonce + "." + raw_body).
# MOCHATRADE_HMAC_SECRET=

# Existing public synthetic risk-check escape hatch for the integration endpoint.
# The War Room has its own explicit AUTO/LIVE/SYNTHETIC evidence modes and does
# not depend on this flag.
# MARKETBRIDGE_ENABLE_PUBLIC_DEMO=1

# Backward-compatible shared-key mode for local/pilot testing.
# MOCHATRADE_INGEST_KEY=

# Stop comparing venue marks after this many seconds without a new mark.
# MARKETBRIDGE_VENUE_MARK_TTL_SECONDS=30

# Append-only analytical decision database (JSONL remains the primary audit log).
# MARKETBRIDGE_DUCKDB_PATH=/absolute/path/to/marketbridge.duckdb

# Enable HSTS even when testing behind a proxy that does not expose HTTPS to FastAPI.
# MARKETBRIDGE_FORCE_HSTS=1

# Optional learned-model bundle. Direct consensus still outranks AI; AI may only
# tighten deterministic controls and never creates a trusted anchor.
# MARKETBRIDGE_AI_MODEL=/absolute/path/to/marketbridge-ai-v0.3.json