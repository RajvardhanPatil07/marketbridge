# MarketBridge runs in safe demo mode without any secrets.
PORT=8000

# Frontend API URL for separate local dev servers only.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Comma-separated browser origins allowed by CORS and the WebSocket endpoint.
# MARKETBRIDGE_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Alpaca live stock WebSocket. `iex` is a single-exchange display/testing feed and
# cannot satisfy MarketBridge's two-venue qualification rule by itself. Use `sip`
# for an execution-grade multi-venue reference only when the account is entitled.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_FEED=sip
# ALPACA_REJECT_CONDITIONS=I
# ALPACA_MAX_NBBO_DEVIATION_BPS=150

# Ticker-linked US financial news. Keep this token on the backend; never expose it
# through NEXT_PUBLIC_* variables or commit a populated value.
# MARKETAUX_API_TOKEN=

# Independent aggregated BBO witness. EQUS.MINI access is entitlement-gated and
# counts as one provider/venue family, never as several underlying exchanges.
# DATABENTO_API_KEY=

# Fail startup/readiness when a qualifying live feed is not configured/ready.
# Enable this in the production backend, not for the offline safety-lab demo.
# MARKETBRIDGE_REQUIRE_LIVE_DATA=1

# Optional mapping from MarketBridge symbols to Hyperliquid deployed market coins.
# Example only; use the exact coin identifiers for the market you are observing.
# HYPERLIQUID_COIN_MAP={"NVDA":"xyz:NVDA","TSLA":"xyz:TSLA"}

# Preferred Mochatrade integration authentication.
# Requests are signed as HMAC-SHA256(timestamp + "." + nonce + "." + raw_body).
# MOCHATRADE_HMAC_SECRET=

# Backward-compatible shared-key mode for local/pilot testing.
# MOCHATRADE_INGEST_KEY=

# Stop comparing venue marks after this many seconds without a new mark.
# MARKETBRIDGE_VENUE_MARK_TTL_SECONDS=30

# Append-only analytical decision database (JSONL remains the primary audit log).
# MARKETBRIDGE_DUCKDB_PATH=/absolute/path/to/marketbridge.duckdb

# Enable HSTS even when testing behind a proxy that does not expose HTTPS to FastAPI.
# MARKETBRIDGE_FORCE_HSTS=1

# Optional learned-model bundle. Defaults to models/marketbridge-ai-v0.3.json.
# Retrain offline with scripts/train_ai_models.py; direct consensus still outranks AI.
# MARKETBRIDGE_AI_MODEL=/absolute/path/to/marketbridge-ai-v0.3.json
